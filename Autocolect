-- Função para encontrar CandyCorn no workspace
local function findCandyCorn()
    local candyCorns = {}
    
    -- Procura por objetos chamados "CandyCorn" ou similares
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            -- Verifica vários nomes possíveis
            if name:find("candy") or name:find("corn") or name:find("candycorn") then
                table.insert(candyCorns, obj)
            end
        end
    end
    
    return candyCorns
end

-- Função para encontrar Ghost Blocks no workspace
local function findGhostBlocks()
    local ghostBlocks = {}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            -- Procura por "ghost" no nome
            if name:find("ghost") then
                -- Verifica se tem ProximityPrompt
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    table.insert(ghostBlocks, {part = obj, prompt = prompt})
                end
            end
        end
        -- Também procura diretamente por ProximityPrompts em objetos com "ghost" no nome
        if obj:IsA("ProximityPrompt") and obj.Parent then
            local parentName = obj.Parent.Name:lower()
            if parentName:find("ghost") then
                table.insert(ghostBlocks, {part = obj.Parent, prompt = obj})
            end
        end
    end
    
    return ghostBlocks
end

-- Função para teleportar o jogador para o centro do objeto
local function teleportTo(position, offset)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    -- Adiciona offset para ficar mais perto do centro
    local finalPosition = position + (offset or Vector3.new(0, 0, 0))
    humanoidRootPart.CFrame = CFrame.new(finalPosition)
    return true
end

-- Função principal de coleta de CandyCorn
local function startCollecting(statusLabel, countLabel)
    collecting = true
    local collected = 0
    
    while collecting do
        statusLabel.Text = "Status: Coletando CandyCorn..."
        statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        
        local candyCorns = findCandyCorn()
        
        if #candyCorns == 0 then
            statusLabel.Text = "Status: Nenhum CandyCorn encontrado!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(3)
        else
            for i, candy in pairs(candyCorns) do
                if not collecting then break end
                
                local position
                local centerOffset = Vector3.new(0, 0, 0)
                
                if candy:IsA("Model") then
                    -- Pega o centro do Model
                    local primaryPart = candy.PrimaryPart or candy:FindFirstChildWhichIsA("BasePart")
                    if primaryPart then
                        position = primaryPart.Position
                        -- Calcula o centro do bounding box
                        local _, size = candy:GetBoundingBox()
                        centerOffset = Vector3.new(0, size.Y / 2, 0)
                    end
                elseif candy:IsA("BasePart") then
                    -- Pega o centro exato da Part
                    position = candy.Position
                    centerOffset = Vector3.new(0, candy.Size.Y / 2, 0)
                end
                
                if position then
                    statusLabel.Text = "Status: Coletando " .. i .. "/" .. #candyCorns
                    
                    -- Teleporta para o centro do CandyCorn
                    teleportTo(position, centerOffset)
                    
                    -- Aguarda baseado na velocidade configurada
                    wait(collectionSpeed)
                    
                    -- Tenta clicar ou tocar no objeto
                    if candy:IsA("BasePart") and candy:FindFirstChild("ClickDetector") then
                        fireclickdetector(candy.ClickDetector)
                    elseif candy:IsA("BasePart") and candy:FindFirstChild("ProximityPrompt") then
                        fireproximityprompt(candy.ProximityPrompt)
                    end
                    
                    collected = collected + 1
                    countLabel.Text = "Coletados: " .. collected
                    
                    wait(0.2)
                end
            end
            
            -- Aguarda antes de verificar novamente
            statusLabel.Text = "Status: Aguardando respawn..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(5)
        end
    end
    
    statusLabel.Text = "Status: Parado"
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end

-- Função para parar a coleta de CandyCorn
local function stopCollecting()
    collecting = false
end

-- Função principal de coleta de Ghost Blocks
local function startCollectingGhosts(statusLabel, countLabel)
    collectingGhosts = true
    local collected = 0
    
    while collectingGhosts do
        statusLabel.Text = "Status: Coletando Ghost Blocks..."
        statusLabel.TextColor3 = Color3.fromRGB(138, 43, 226)
        
        local ghostBlocks = findGhostBlocks()
        
        if #ghostBlocks == 0 then
            statusLabel.Text = "Status: Nenhum Ghost Block encontrado!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(3)
        else
            for i, ghost in pairs(ghostBlocks) do
                if not collectingGhosts then break end
                
                local part = ghost.part
                local prompt = ghost.prompt
                
                if part and prompt then
                    local position
                    local centerOffset = Vector3.new(0, 0, 0)
                    
                    if part:IsA("Model") then
                        local primaryPart = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
                        if primaryPart then
                            position = primaryPart.Position
                            local _, size = part:GetBoundingBox()
                            centerOffset = Vector3.new(0, size.Y / 2, 0)
                        end
                    elseif part:IsA("BasePart") then
                        position = part.Position
                        centerOffset = Vector3.new(0, part.Size.Y / 2, 0)
                    end
                    
                    if position then
                        statusLabel.Text = "Status: Coletando Ghost " .. i .. "/" .. #ghostBlocks
                        
                        -- Teleporta para o centro do Ghost Block
                        teleportTo(position, centerOffset)
                        
                        wait(collectionSpeed)
                        
                        -- Simula segurar o botão no ProximityPrompt
                        prompt.HoldDuration = prompt.HoldDuration or 0
                        local holdTime = prompt.HoldDuration
                        
                        -- Ativa o prompt
                        fireproximityprompt(prompt)
                        
                        -- Se tiver HoldDuration, espera esse tempo
                        if holdTime > 0 then
                            wait(holdTime + 0.1)
                        else
                            wait(0.5)
                        end
                        
                        collected = collected + 1
                        countLabel.Text = "Ghost Coletados: " .. collected
                        
                        wait(0.2)
                    end
                end
            end
            
            -- Aguarda antes de verificar novamente
            statusLabel.Text = "Status: Aguardando respawn de Ghosts..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(5)
        end
    end
    
    statusLabel.Text = "Status: Parado"
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end

