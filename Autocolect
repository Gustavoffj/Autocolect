-- Função para encontrar CandyCorn no workspace
local function findCandyCorn()
    local candyCorns = {}
    
    -- Procura por objetos chamados "CandyCorn" ou similares
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            -- Verifica vários nomes possíveis
            if name:find("candy") or name:find("corn") or name:find("candycorn") or name:find("valentim") or name:find("heart") or name:find("valentine") then
                table.insert(candyCorns, obj)
            end
        end
    end
    
    return candyCorns
end

-- Função para teleportar o jogador
local function teleportTo(position)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    humanoidRootPart.CFrame = CFrame.new(position)
    return true
end

-- Função principal de coleta
local function startCollecting(statusLabel, countLabel)
    collecting = true
    local collected = 0
    
    while collecting do
        statusLabel.Text = "Status: Coletando..."
        statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        
        local candyCorns = findCandyCorn()
        
        if #candyCorns == 0 then
            statusLabel.Text = "Status: Nenhum item encontrado!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(3)
        else
            for i, candy in pairs(candyCorns) do
                if not collecting then break end
                
                local position
                if candy:IsA("Model") then
                    position = candy:GetPrimaryPartCFrame() and candy:GetPrimaryPartCFrame().Position or candy:GetModelCFrame().Position
                elseif candy:IsA("BasePart") then
                    position = candy.Position
                end
                
                if position then
                    statusLabel.Text = "Status: Coletando " .. i .. "/" .. #candyCorns
                    
                    -- Teleporta para o item
                    teleportTo(position)
                    
                    -- Aguarda baseado na velocidade configurada
                    wait(collectSpeed)
                    
                    -- Tenta clicar ou tocar no objeto
                    if candy:IsA("BasePart") and candy:FindFirstChild("ClickDetector") then
                        fireclickdetector(candy.ClickDetector)
                    elseif candy:IsA("BasePart") and candy:FindFirstChild("ProximityPrompt") then
                        fireproximityprompt(candy.ProximityPrompt)
                    end
                    
                    collected = collected + 1
                    countLabel.Text = "Coletados: " .. collected
                    
                    wait(0.3)
                end
            end
            
            -- Aguarda antes de verificar novamente
            statusLabel.Text = "Status: Aguardando respawn..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(5)
        end
    end
    
    statusLabel.Text = "Status: Parado"
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end

-- Função para parar a coleta
local function stopCollecting()
    collecting = false
end

