end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
    if dragging then
        local mouse = LocalPlayer:GetMouse()
        local relativeX = mouse.X - sliderFrame.AbsolutePosition.X
        local percentage = math.clamp(relativeX / sliderFrame.AbsoluteSize.X, 0, 1)
        
        -- Atualiza posição do botão
        sliderButton.Position = UDim2.new(percentage, -12.5, 0.5, -12.5)
        
        -- Atualiza fill
        sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
        
        -- Calcula velocidade (0.1s a 2s)
        collectionSpeed = 0.1 + (percentage * 1.9)
        speedLabel.Text = string.format("Velocidade: %.2fs", collectionSpeed)
    end
end)

