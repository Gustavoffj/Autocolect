-- FUNÇÃO CORRIGIDA para encontrar CandyCorn
local function findCandyCorn()
    local candyCorns = {}
    
    -- Procura especificamente por objetos chamados "CandyCorn"
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == "CandyCorn" and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("MeshPart")) then
            table.insert(candyCorns, obj)
        end
    end
    
    return candyCorns
end

-- FUNÇÃO MELHORADA de teleporte
local function teleportTo(position)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    -- Teleporta um pouco acima para evitar ficar preso
    humanoidRootPart.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
    task.wait(0.1)
    
    return true
end

-- FUNÇÃO MELHORADA para coletar item
local function collectItem(item)
    local success = false
    
    -- Método 1: ClickDetector
    local clickDetector = item:FindFirstChildOfClass("ClickDetector")
    if clickDetector then
        pcall(function()
            fireclickdetector(clickDetector)
            success = true
        end)
    end
    
    -- Método 2: ProximityPrompt
    local proximityPrompt = item:FindFirstChildOfClass("ProximityPrompt")
    if proximityPrompt then
        pcall(function()
            fireproximityprompt(proximityPrompt)
            success = true
        end)
    end
    
    -- Método 3: TouchInterest (tocar no objeto)
    local character = LocalPlayer.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart and item:IsA("BasePart") then
            pcall(function()
                firetouchinterest(humanoidRootPart, item, 0)
                task.wait(0.1)
                firetouchinterest(humanoidRootPart, item, 1)
                success = true
            end)
        end
    end
    
    return success
end

-- Função principal de coleta CORRIGIDA
local function startCollecting(statusLabel, countLabel)
    collecting = true
    local collected = 0
    
    while collecting do
        statusLabel.Text = "Status: Coletando..."
        statusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
        
        local candyCorns = findCandyCorn()
        
        if #candyCorns == 0 then
            statusLabel.Text = "Status: Nenhum CandyCorn encontrado!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            task.wait(3)
        else
            for i, candy in pairs(candyCorns) do
                if not collecting then break end
                
                -- Verifica se o item ainda existe
                if not candy or not candy.Parent then
                    continue
                end
                
                local position
                if candy:IsA("Model") then
                    local primaryPart = candy.PrimaryPart or candy:FindFirstChildWhichIsA("BasePart")
                    if primaryPart then
                        position = primaryPart.Position
                    end
                elseif candy:IsA("BasePart") then
                    position = candy.Position
                end
                
                if position then
                    statusLabel.Text = "Status: Coletando " .. i .. "/" .. #candyCorns
                    
                    -- Teleporta para o CandyCorn
                    if teleportTo(position) then
                        task.wait(0.2)
                        
                        -- Tenta coletar
                        if collectItem(candy) then
                            collected = collected + 1
                            countLabel.Text = "Coletados: " .. collected
                        end
                        
                        -- Aguarda baseado na velocidade configurada
                        task.wait(collectSpeed)
                    end
                end
            end
            
            -- Aguarda antes de verificar novamente
            statusLabel.Text = "Status: Aguardando respawn..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            task.wait(5)
        end
    end
    
    statusLabel.Text = "Status: Parado"
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end

-- Função para parar a coleta
local function stopCollecting()
    collecting = false
end

