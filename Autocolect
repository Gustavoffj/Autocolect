    speedLabel.Text = "⚡ Velocidade: " .. speedName
    
    -- Reset de cores
    speedBtnSlow.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
    speedBtnNormal.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
    speedBtnFast.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
    
    speedBtnSlow.Font = Enum.Font.Gotham
    speedBtnNormal.Font = Enum.Font.Gotham
    speedBtnFast.Font = Enum.Font.Gotham
    
    -- Destaca o botão selecionado
    button.BackgroundColor3 = Color3.fromRGB(255, 105, 180)
    button.Font = Enum.Font.GothamBold
end

